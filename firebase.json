{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "supabase/**",
      ".github/**",
      "PAYSTACK_SETUP.md",
      "STORAGE_SETUP.md",
      "*.bat"
    ],
    "rewrites": [
      {
        "source": "/home{,/**}",
        "destination": "/index.html"
      },
      {
        "source": "/workspace{,/**}",
        "destination": "/app.html"
      },
      {
        "source": "/companion{,/**}",
        "destination": "/scife.html"
      }
    ]
  }
}
