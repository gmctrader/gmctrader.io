{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "supabase/**",
      ".github/**",
      "PAYSTACK_SETUP.md",
      "STORAGE_SETUP.md",
      "*.bat"
    ],
    "rewrites": [
      {
        "source": "/workspace{,/**}",
        "destination": "/app.html"
      }
    ]
  }
}
