{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "supabase/**",
      ".github/**",
      "PAYSTACK_SETUP.md",
      "STORAGE_SETUP.md",
      "*.bat"
    ],
    "rewrites": [
      {
        "source": "/home{,/**}",
        "destination": "/index.html"
      },
      {
        "source": "/workspace{,/**}",
        "destination": "/app.html"
      },
      {
        "source": "/companion{,/**}",
        "destination": "/scife.html"
      }
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/app.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/workspace",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/workspace/**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      }
    ]
  }
}
